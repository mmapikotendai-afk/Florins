# Local development only. Use your provider's TLS connection URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/florins?schema=public"
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/florins?schema=public"
# Dedicated local integration database. Must end in _test.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/florins_test?schema=public"
# Set the verified canonical origin before publishing.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional server-only origin override; defaults to the public URL above.
# Useful when the same production bundle is run at a different local origin.
SITE_ORIGIN="http://localhost:3000"
# Keep online appointment requests closed until real services/schedules are approved.
BOOKING_ENABLED="false"
# Generate a random secret of at least 32 characters; keep it stable for token validity.
BOOKING_TOKEN_SECRET=""
# production excludes sample records; use development only in isolated environments.
FLORINS_ENV="production"
ALLOW_DEVELOPMENT_SEED="false"
# Supabase Auth verifies administrator access. AdminUser must also allow the user UUID.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Optional: only set to a header overwritten by a trusted reverse proxy.
# Without it, rate limits use a shared bucket for all visitors.
RATE_LIMIT_TRUSTED_HEADER=""
